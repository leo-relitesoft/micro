{
    "name": "leo/service-admin",
    "type": "project",
    "description": "Site admin backend microservice",
    "config": {
        "process-timeout" : 900,
        "sort-packages" : true
    },
    "require": {
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5",
        "roave/security-advisories": "dev-master"
    },
    "scripts": {
        "test": "phpunit --colors=always"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "tests/"
        }
    }
}
