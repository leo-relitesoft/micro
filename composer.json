{
    "name": "leo/service-admin",
    "description": "Site admin backend microservice",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "leo"
        }
    ],
    "require-dev": {
        "overtrue/phplint": "^1.2",
        "phpunit/phpunit": "^8.5",
        "roave/security-advisories": "dev-master",
        "squizlabs/php_codesniffer": "^3.5",
        "vimeo/psalm": "^3.8"
    },
    "scripts": {
        "lint": "phplint",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "psalm": "psalm",
        "test": "phpunit --colors=always",
        "test-unit-coverage": "phpunit --colors=always --testsuite=unit --coverage-html var/coverage",
    }
}
