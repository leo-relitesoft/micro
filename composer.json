{
    "name": "leo/service-admin",
    "type": "project",
    "description": "Site admin backend microservice",
    "config": {
        "process-timeout" : 1800,
        "sort-packages" : true,
        "platform": {
            "php": "8.1"
        }
    },
    "require": {
        "ext-json": "*",
        "php-di/php-di": "^7.1",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "webmozart/assert": "^1.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "roave/security-advisories": "dev-master"
    },
    "scripts": {
        "test": "phpunit --colors=always"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "tests/"
        }
    }
}
